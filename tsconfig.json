{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@gebeyaos/shared-types": ["packages/shared-types/src"],
      "@gebeyaos/sync-protocol": ["packages/sync-protocol/src"]
    }
  },
  "include": [
    "apps/branch-server/src/**/*",
    "apps/branch-server/test/**/*",
    "apps/hq-server/src/**/*",
    "apps/hq-server/test/**/*",
    "apps/pos-web/src/**/*",
    "packages/shared-types/src/**/*",
    "packages/sync-protocol/src/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "backend",
    "scratch"
  ]
}

