# ============================================================
# GebeyaOS Branch Server – Environment Template (Part 0, Fix #3 & #4)
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit your real .env to version control.
#
# To generate a secret:
#   node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================

# ── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
APP_VERSION=1.0.0

# ── Database ─────────────────────────────────────────────────
# PostgreSQL is bound to localhost (127.0.0.1) only.
# NEVER expose port 5432 to the network.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=gebeyaos_app          # limited user, NOT postgres superuser
DB_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD
DB_NAME=gebeyaos_branch

# ── Security ─────────────────────────────────────────────────
# Generate both with: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_32_PLUS_RANDOM_BYTES
ENCRYPTION_KEY=CHANGE_ME_32_PLUS_RANDOM_BYTES
JWT_EXPIRES_IN=8h

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production: only the LAN address(es) of cashier terminals.
# Example: http://192.168.1.100:3000,http://192.168.1.101:3000
CORS_ORIGINS=http://localhost:3000

# ── Branch Activation ────────────────────────────────────────
# DO NOT hard-code TENANT_ID or BRANCH_ID here.
# They are assigned during the branch activation flow.
# The server will refuse to start in production if these are still placeholder values.
# TENANT_ID=  ← set automatically on first activation
# BRANCH_ID=  ← set automatically on first activation

# ── HQ Sync ──────────────────────────────────────────────────
# Leave blank for air-gapped branches (offline-only mode).
HQ_SYNC_URL=

# ── File Storage ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── Timezone ─────────────────────────────────────────────────
TZ=Africa/Addis_Ababa
